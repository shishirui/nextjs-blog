{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rexshi-com",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "rexshi.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.rexshi.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://rexshi.com",
  },
  "observability": {
    "enabled": true,
  },
}
